# Caddy in front of Handout. One file for the workbench and for a deployment: the port and
# every upstream come from the environment and fall back to the workbench's values.
#
# The trusted_proxies block must stay the first block in the file. `monoceros share` puts its
# own HTTPS terminator in front of Caddy and forwards over plain http, passing the original
# scheme in the headers; without this, Caddy replaces it with what it sees. That is what makes
# X-Forwarded-Proto / X-Forwarded-Host trustworthy for the stories that read them — see
# docs/proxy.md.
{
	servers {
		trusted_proxies static private_ranges
	}
}

# No domain name in the site address, on purpose: with one, Caddy would try to obtain a TLS
# certificate and fail. The port has to match the caddy service's port/httpPort (81 here).
# There is no certificate ask-endpoint: one instance answers under one hostname, so a
# deployment's site address carries that one hostname and Caddy obtains one ordinary
# certificate for it.
:{$CADDY_SITE_PORT:81} {
	# The application: its own routes and its built assets, including the design layer below
	# them. In the workbench that is the Vite dev server; in a deployment WEB_HOST/WEB_PORT
	# point at the service, which serves the built app. A trailing `*` would also match
	# `/appleee`, a legal handout address — so this matcher lists the exact segment and the
	# segment with a slash instead.
	@app path /app /app/*
	handle @app {
		reverse_proxy {$WEB_HOST:workspace}:{$WEB_PORT:5173}
	}

	# The HTTP interface. Goes straight to the service rather than through the dev server: in
	# a deployment WEB_HOST is the service anyway, and the browser sees one origin either way
	# because Caddy is the origin. The Vite proxy for /api stays, so a direct visit to the dev
	# server's own port keeps working.
	@api path /api /api/*
	handle @api {
		reverse_proxy {$APP_HOST:workspace}:{$APP_PORT:3000}
	}

	# The instance's identity provider, when it runs beside Handout rather than in a cloud.
	# In the workbench that is Keycloak; against a hosted provider nothing ever requests these
	# paths. /resources/* is not decoration: Keycloak's login page loads its assets from there
	# (measured), and without this handle the page arrives unstyled and its assets land in
	# handout space.
	@provider path /realms /realms/* /resources /resources/*
	handle @provider {
		reverse_proxy {$KEYCLOAK_HOST:keycloak}:{$KEYCLOAK_PORT:8080}
	}

	# Everything else is handout space and belongs to the service.
	handle {
		reverse_proxy {$APP_HOST:workspace}:{$APP_PORT:3000}
	}
}
