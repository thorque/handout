# Early warning, not the rule: appends a Signed-off-by trailer so a plain `git commit`
# still ends up signed off. Husky runs this under `sh -e`, so every command whose exit
# status could abort the commit is guarded -- a command substitution inside an assignment
# aborts `sh -e` just like any other failing command, and `git config user.name` /
# `user.email` fail (exit 1) whenever they are unset. This layer must never reject a
# commit; the pull-request check is what actually enforces the rule.
#
# `git var GIT_AUTHOR_IDENT` resolves the identity the same way `git commit` itself would
# -- git config, then GIT_AUTHOR_NAME/GIT_AUTHOR_EMAIL, then GECOS -- so a commit made
# from environment variables alone (CI, containers without a configured user) still gets
# a correct trailer instead of being treated as unidentifiable.
ident=$(git var GIT_AUTHOR_IDENT 2>/dev/null) || true
name=$(printf '%s' "$ident" | sed -n 's/^\(.*\) <.*$/\1/p') || true
email=$(printf '%s' "$ident" | sed -n 's/^.*<\(.*\)>.*$/\1/p') || true

if [ -z "$name" ] || [ -z "$email" ]; then
  echo "no usable git identity — not signing off; the check on the pull request will ask for it" >&2
  exit 0
fi

git interpret-trailers --if-exists doNothing \
  --trailer "Signed-off-by: $name <$email>" \
  --in-place "$1" >/dev/null 2>&1 ||
  echo "could not append the sign-off; use git commit -s" >&2

exit 0
