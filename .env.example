# Handout service. Copy to .env for local development.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Where published content lives: <HANDOUT_DATA_DIR>/handouts/<slug>/. Must be an absolute
# path — readDataDir rejects a relative one. Defaults to <repo>/var/data when unset, which
# is what the workbench and `npm run smoke` both use.
# HANDOUT_DATA_DIR=/var/lib/handout

# The workbench provides POSTGRES_URL in the environment and DATABASE_URL falls back to it,
# so there is nothing to set here. Do not copy the value into this file.
# DATABASE_URL=$POSTGRES_URL
# The schema the migrations and the pool work in. Only the tests change this.
# HANDOUT_DATABASE_SCHEMA=public

# Encrypts handout passwords, which have to stay readable for their owner — so this key
# is required and belongs in the backup plan: lose it and no password can be looked up
# again. 32 random bytes, base64. Generate your own with: openssl rand -base64 32
# The value below decodes to "development-only-key-never-use!!" — a placeholder, not a key.
HANDOUT_PASSWORD_KEY=ZGV2ZWxvcG1lbnQtb25seS1rZXktbmV2ZXItdXNlISE=

# The instance's identity provider — publishers sign in against it, recipients never do.
# The workbench value is the dev realm, reached through Caddy so the browser and the
# service agree on one issuer. http is accepted only for localhost, a *.localhost name,
# 127.0.0.1 or [::1] — anywhere else it is a misconfiguration and the service refuses to
# start.
HANDOUT_OIDC_ISSUER_URL=http://handout-caddy.localhost/realms/handout
HANDOUT_OIDC_CLIENT_ID=handout
# The dev realm's fixed, obviously-fake secret — a value for a throwaway local realm,
# never a real instance's. Same category as the HANDOUT_PASSWORD_KEY placeholder above.
HANDOUT_OIDC_CLIENT_SECRET=development-only-secret-never-use
# Who may publish here: a comma-separated mix of domains and full addresses. A domain
# matches exactly, case-insensitively, never a subdomain and never as a suffix. An address
# the provider marks unverified is refused regardless.
HANDOUT_ALLOWED_EMAILS=berger-partner.de, t.kuhn@extern-gmbh.de
# The sign-in button's caption. Defaults to "Mit Firmenkonto anmelden" when unset or blank.
# HANDOUT_SIGN_IN_LABEL=Mit Firmenkonto anmelden
# Where the service reaches the provider, when that differs from where the browser reaches
# it (the workbench: the browser goes through Caddy, the service reaches Keycloak
# in-network). Falls back to KEYCLOAK_URL, which the workbench already provides — dotenv
# does not expand $VAR, which is why that fallback lives in the code and not in this file.
# In a deployment where issuer and service both reach the same address, leave this unset.
# HANDOUT_OIDC_INTERNAL_ORIGIN=http://keycloak:8080

# The largest file POST /api/handouts accepts, in bytes. Defaults to 26214400 (25 MB) — a
# Claude artifact with embedded images is rarely larger, and the same limit will serve the
# zip upload of a later story.
# HANDOUT_MAX_UPLOAD_BYTES=26214400

# ---------------------------------------------------------------------------------------
# `docker compose` reads this same file by default, which is why the compose-only
# variables sit here rather than in a second env file. They are read by compose.yaml and
# caddy/Caddyfile, not by the service directly — commented so `${…:?}` fails loudly until
# they are filled in. LOG_LEVEL and HANDOUT_PASSWORD_KEY above are shared by both.
# ---------------------------------------------------------------------------------------
# POSTGRES_USER=handout
# POSTGRES_PASSWORD=
# POSTGRES_DB=handout
# HANDOUT_HTTP_PORT=80
# CADDY_SITE_PORT=80
# APP_HOST=handout
# APP_PORT=3000
# WEB_HOST=handout
# WEB_PORT=3000
